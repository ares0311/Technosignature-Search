{
  "permissions": {
    "deny": [
      "Agent",
      "TeamCreate",
      "TeamDelete"
    ]
  },
  "disableAgentView": true,
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.sh\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.sh\"'"
          }
        ]
      }
    ]
  }
}
